{
  "name": "@wavyx/exactcli",
  "version": "0.14.4",
  "publishConfig": {
    "access": "public"
  },
  "description": "Command-line interface for Exact Online",
  "type": "module",
  "license": "MIT",
  "author": "Eric Rodriguez",
  "homepage": "https://github.com/wavyx/exactcli",
  "repository": {
    "type": "git",
    "url": "https://github.com/wavyx/exactcli.git"
  },
  "bugs": {
    "url": "https://github.com/wavyx/exactcli/issues"
  },
  "bin": {
    "exactcli": "./bin/run.js"
  },
  "files": [
    "bin",
    "src",
    "oclif.manifest.json",
    "CHANGELOG.md",
    "docs/recipes.md",
    "docs/coverage.md"
  ],
  "engines": {
    "node": ">=20"
  },
  "keywords": [
    "exact-online",
    "accounting",
    "cli",
    "oclif",
    "odata",
    "mcp",
    "automation"
  ],
  "oclif": {
    "bin": "exactcli",
    "dirname": "exactcli",
    "commands": {
      "strategy": "pattern",
      "target": "./src/commands",
      "globPatterns": [
        "**/*.js",
        "!**/*.test.js"
      ]
    },
    "topicSeparator": " ",
    "topics": {
      "stock-count": {
        "description": "Stock counts (inventory)"
      },
      "warehouse-transfer": {
        "description": "Warehouse transfers (inventory)"
      },
      "assembly-order": {
        "description": "Assembly orders (manufacturing)"
      },
      "return": {
        "description": "Return requests: VAT and payroll declarations"
      },
      "custom-field": {
        "description": "Custom fields on records"
      },
      "auth": {
        "description": "Authenticate with Exact Online (OAuth 2.0)"
      },
      "profile": {
        "description": "Manage named profiles"
      },
      "config": {
        "description": "Read and write profile configuration"
      },
      "division": {
        "description": "Divisions (administrations)"
      },
      "sales-entry": {
        "description": "Sales entries (accounting)"
      },
      "purchase-entry": {
        "description": "Purchase entries (accounting)"
      },
      "transaction-line": {
        "description": "Transaction lines (general ledger detail)"
      },
      "account": {
        "description": "Accounts (customers and suppliers)"
      },
      "gl-account": {
        "description": "General ledger accounts"
      },
      "document": {
        "description": "Documents and attachments"
      },
      "sync": {
        "description": "Incremental reads (the sync API)"
      },
      "journal": {
        "description": "Journals (cash, bank, sales, purchase, general)"
      },
      "vat-code": {
        "description": "VAT codes"
      },
      "item": {
        "description": "Items (products and services)"
      },
      "contact": {
        "description": "Contacts (the persons of an account)"
      },
      "sales-invoice": {
        "description": "Sales invoices (invoices sent to customers)"
      },
      "purchase-invoice": {
        "description": "Purchase invoices (invoices received from suppliers)"
      },
      "bank-entry": {
        "description": "Bank entries (bank statement headers)"
      },
      "journal-entry": {
        "description": "General journal entries (manual bookings, OD)"
      },
      "receivable": {
        "description": "Receivables (outstanding customer items)"
      },
      "payment-condition": {
        "description": "Payment conditions"
      },
      "document-type": {
        "description": "Document types (the Type codes of documents)"
      },
      "invoice": {
        "description": "Sales invoices (create from codes)"
      },
      "sales-order": {
        "description": "Sales orders (orders placed by customers)"
      },
      "quotation": {
        "description": "Quotations (offers sent to prospects and customers)"
      },
      "webhook": {
        "description": "Webhook subscriptions"
      },
      "currency": {
        "description": "Currencies"
      },
      "exchange-rate": {
        "description": "Exchange rates"
      },
      "payment": {
        "description": "Payments (outstanding supplier items to pay)"
      },
      "bank-account": {
        "description": "Bank accounts of customers and suppliers"
      },
      "address": {
        "description": "Addresses of customers and suppliers"
      },
      "balance": {
        "description": "Trial balance (amounts per ledger account and period)"
      },
      "financial-period": {
        "description": "Financial periods (the bookkeeping calendar)"
      },
      "gl-classification": {
        "description": "Ledger classifications (reporting scheme elements)"
      },
      "aging-receivable": {
        "description": "Aged receivables per customer"
      },
      "aging-payable": {
        "description": "Aged payables per supplier"
      },
      "profit-loss": {
        "description": "Profit and loss overview"
      },
      "receivables-list": {
        "description": "Open receivable invoices per customer (financial report)"
      },
      "payables-list": {
        "description": "Open payable invoices per supplier (financial report)"
      },
      "revenue": {
        "description": "Revenue per reporting year and period"
      },
      "aging-overview": {
        "description": "Open receivables and payables per age group"
      },
      "purchase-order": {
        "description": "Purchase orders (orders sent to suppliers)"
      },
      "goods-delivery": {
        "description": "Goods deliveries (shipments of sales orders)"
      },
      "item-group": {
        "description": "Item groups and their ledger accounts"
      },
      "cost-center": {
        "description": "Cost centers"
      },
      "cost-unit": {
        "description": "Cost units"
      },
      "project": {
        "description": "Projects (time and cost projects)"
      },
      "budget": {
        "description": "Budgets (amounts per ledger account and period)"
      },
      "asset": {
        "description": "Fixed assets (investments and depreciation)"
      },
      "subscription": {
        "description": "Subscriptions (recurring invoice contracts)"
      },
      "cash-entry": {
        "description": "Cash entries (cash book headers)"
      },
      "mailbox": {
        "description": "Mailboxes (digital postbox and scan service)"
      },
      "mail-message": {
        "description": "Sent mail messages (digital postbox and scan service)"
      },
      "bank-statement": {
        "description": "Bank statement files (CODA, MT940, CAMT) sent to the bank import"
      },
      "mandate": {
        "description": "Direct debit mandates (SEPA Core and B2B)"
      },
      "opening-balance": {
        "description": "Opening balances of balance sheet accounts"
      },
      "alias": {
        "description": "Short names for longer commands"
      },
      "opportunity": {
        "description": "Opportunities (sales pipeline)"
      },
      "supplier-item": {
        "description": "Supplier item links (purchase prices per supplier)"
      },
      "sales-price": {
        "description": "Sales item prices"
      },
      "document-folder": {
        "description": "Document folders"
      },
      "time-entry": {
        "description": "Project time entries"
      },
      "cost-entry": {
        "description": "Project cost entries"
      },
      "warehouse": {
        "description": "Warehouses"
      },
      "depreciation-method": {
        "description": "Depreciation methods of fixed assets"
      },
      "sales-channel": {
        "description": "Sales channels"
      },
      "task": {
        "description": "Tasks (activities)"
      },
      "event": {
        "description": "Events (activities)"
      },
      "communication-note": {
        "description": "Communication notes (activities)"
      },
      "goods-receipt": {
        "description": "Goods receipts of purchase orders"
      }
    },
    "hooks": {
      "command_not_found": "./src/hooks/command-not-found.js"
    },
    "plugins": [
      "@oclif/plugin-help",
      "@oclif/plugin-plugins",
      "@oclif/plugin-autocomplete"
    ]
  },
  "dependencies": {
    "@inquirer/prompts": "8.7.3",
    "@modelcontextprotocol/sdk": "1.32.1",
    "@napi-rs/keyring": "1.3.0",
    "@oclif/core": "4.11.4",
    "@oclif/plugin-autocomplete": "3.2.50",
    "@oclif/plugin-help": "6.2.49",
    "@oclif/plugin-plugins": "5.4.69",
    "chalk": "5.6.2",
    "cli-table3": "0.6.5",
    "conf": "15.1.0",
    "debug": "4.4.3",
    "js-yaml": "4.1.1",
    "node-jq": "6.3.1",
    "open": "11.0.4",
    "ora": "9.4.1",
    "zod": "4.6.6"
  },
  "devDependencies": {
    "@eslint/js": "10.0.1",
    "@oclif/test": "4.1.18",
    "@vitest/coverage-v8": "4.1.7",
    "eslint": "10.12.0",
    "globals": "17.13.0",
    "nock": "14.0.15",
    "oclif": "6.0.8",
    "prettier": "3.9.10",
    "vitest": "4.1.7"
  },
  "scripts": {
    "build": "oclif manifest",
    "docs:commands": "npm run build && node scripts/gen-commands.mjs",
    "docs:coverage": "npm run build && node scripts/gen-coverage.mjs",
    "catalog:build": "node scripts/build-catalog.mjs",
    "lint": "eslint . && prettier --check .",
    "lint:fix": "eslint --fix . && prettier --write .",
    "test": "vitest run",
    "test:watch": "vitest",
    "pretest:coverage": "npm run build",
    "test:coverage": "vitest run --coverage",
    "prepare": "npm run build",
    "postpack": "rm -f oclif.manifest.json"
  },
  "allowScripts": {
    "node-jq@6.3.1": true
  }
}
