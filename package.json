{
  "name": "@wavyx/exactcli",
  "version": "0.2.0",
  "publishConfig": {
    "access": "public"
  },
  "description": "Command-line interface for Exact Online",
  "type": "module",
  "license": "MIT",
  "author": "Eric Rodriguez",
  "homepage": "https://github.com/wavyx/exactcli",
  "repository": {
    "type": "git",
    "url": "https://github.com/wavyx/exactcli.git"
  },
  "bugs": {
    "url": "https://github.com/wavyx/exactcli/issues"
  },
  "bin": {
    "exactcli": "./bin/run.js"
  },
  "files": [
    "bin",
    "src",
    "oclif.manifest.json",
    "CHANGELOG.md"
  ],
  "engines": {
    "node": ">=20"
  },
  "keywords": [
    "exact-online",
    "accounting",
    "cli",
    "oclif",
    "odata",
    "mcp",
    "automation"
  ],
  "oclif": {
    "bin": "exactcli",
    "dirname": "exactcli",
    "commands": {
      "strategy": "pattern",
      "target": "./src/commands",
      "globPatterns": [
        "**/*.js",
        "!**/*.test.js"
      ]
    },
    "topicSeparator": " ",
    "topics": {
      "auth": {
        "description": "Authenticate with Exact Online (OAuth 2.0)"
      },
      "profile": {
        "description": "Manage named profiles"
      },
      "config": {
        "description": "Read and write profile configuration"
      },
      "division": {
        "description": "Divisions (administrations)"
      },
      "sales-entry": {
        "description": "Sales entries (accounting)"
      },
      "purchase-entry": {
        "description": "Purchase entries (accounting)"
      },
      "transaction-line": {
        "description": "Transaction lines (general ledger detail)"
      },
      "account": {
        "description": "Accounts (customers and suppliers)"
      },
      "gl-account": {
        "description": "General ledger accounts"
      },
      "document": {
        "description": "Documents and attachments"
      },
      "sync": {
        "description": "Incremental reads (the sync API)"
      }
    },
    "hooks": {
      "command_not_found": "./src/hooks/command-not-found.js"
    },
    "plugins": [
      "@oclif/plugin-help",
      "@oclif/plugin-plugins",
      "@oclif/plugin-autocomplete"
    ]
  },
  "dependencies": {
    "@inquirer/prompts": "8.5.0",
    "@modelcontextprotocol/sdk": "1.29.0",
    "@napi-rs/keyring": "1.3.0",
    "@oclif/core": "4.11.4",
    "@oclif/plugin-autocomplete": "3.2.50",
    "@oclif/plugin-help": "6.2.49",
    "@oclif/plugin-plugins": "5.4.69",
    "chalk": "5.6.2",
    "cli-table3": "0.6.5",
    "conf": "15.1.0",
    "debug": "4.4.3",
    "js-yaml": "4.1.1",
    "node-jq": "6.3.1",
    "open": "11.0.0",
    "ora": "9.4.0",
    "zod": "4.4.3"
  },
  "devDependencies": {
    "@eslint/js": "10.0.1",
    "@oclif/test": "4.1.18",
    "@vitest/coverage-v8": "4.1.7",
    "eslint": "10.4.0",
    "globals": "17.6.0",
    "nock": "14.0.15",
    "oclif": "4.23.8",
    "prettier": "3.8.3",
    "vitest": "4.1.7"
  },
  "scripts": {
    "build": "oclif manifest",
    "docs:commands": "npm run build && node scripts/gen-commands.mjs",
    "catalog:build": "node scripts/build-catalog.mjs",
    "lint": "eslint . && prettier --check .",
    "lint:fix": "eslint --fix . && prettier --write .",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage",
    "prepare": "npm run build",
    "postpack": "rm -f oclif.manifest.json"
  },
  "allowScripts": {
    "node-jq@6.3.1": true
  }
}
