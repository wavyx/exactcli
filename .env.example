# exactcli reads these from the shell environment, not from this file.
# bin/dev.js loads the file for development only, and only EXACTCLI_ keys.
# OAuth app registration: Company name > Import/Export > App registrations.
EXACTCLI_CLIENT_ID=
# OAuth client secret. Prefer `exactcli auth login`, which uses the OS keychain.
EXACTCLI_CLIENT_SECRET=
# Named profile to use instead of the active one.
EXACTCLI_PROFILE=
# Directory of the configuration store. Use it to isolate CI runs.
EXACTCLI_CONFIG_DIR=
# Division (administration) code to use instead of the profile default.
EXACTCLI_DIVISION=
# Access token for CI. It wins over the keychain when set.
EXACTCLI_ACCESS_TOKEN=
# Localhost mock endpoint. It needs EXACTCLI_ACCESS_TOKEN and refuses any
# other host. Export it in the shell: bin/dev.js loads it too.
EXACTCLI_BASE_URL=
# Path of the jq binary that --jq spawns. Export it in the shell only.
JQ_PATH=
# Upper bound in ms on a single --jq call. Export it in the shell only.
EXACTCLI_JQ_TIMEOUT_MS=
