# OAuth app registration: Company name > Import/Export > App registrations.
EXACTCLI_CLIENT_ID=
# OAuth client secret. Prefer `exactcli auth login`, which uses the OS keychain.
EXACTCLI_CLIENT_SECRET=
# Named profile to use instead of the active one.
EXACTCLI_PROFILE=
# Directory of the configuration store. Use it to isolate CI runs.
EXACTCLI_CONFIG_DIR=
# Division (administration) code to use instead of the profile default.
EXACTCLI_DIVISION=
# Access token for CI. It wins over the keychain when set.
EXACTCLI_ACCESS_TOKEN=
