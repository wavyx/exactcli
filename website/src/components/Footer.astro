---
/* exactcli: Starlight's default footer (pager, edit link), then the brand
   footer on every docs page. */
import Default from '@astrojs/starlight/components/Footer.astro'

const base = import.meta.env.BASE_URL.replace(/\/?$/, '/')
---

<Default><slot /></Default>

<footer class="site-footer">
  <div class="site-footer__inner">
    <span>exactcli is open source under the MIT license. It is not affiliated with or endorsed by Exact.</span>
    <nav class="site-footer__links" aria-label="Footer">
      <a href={`${base}guides/overview/`}>Guide</a>
      <a href={`${base}reference/commands/`}>Commands</a>
      <a href="https://github.com/wavyx/exactcli">GitHub</a>
      <a href="https://www.npmjs.com/package/@wavyx/exactcli">npm</a>
    </nav>
  </div>
</footer>
